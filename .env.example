# Base path the app is served from. GitHub Pages: /<repo-name>/  ·  local / Vercel / Netlify: /
VITE_BASE=/

# Public URL of the MacroAgent proxy (Cloudflare Worker), e.g. https://macrotable-agent-proxy.<you>.workers.dev
# NOT a secret. Never put the Gemini API key in any VITE_* variable — it would be visible in the bundle.
VITE_AGENT_PROXY_URL=
